NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Somente servidor (NUNCA com prefixo NEXT_PUBLIC_). Local: "Secret" do supabase start.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp da equipe (so digitos, com 55). Aparece no painel do vendedor para contratar o destaque.
NEXT_PUBLIC_CONTATO_WHATSAPP=

# Quem responde pelos dados (LGPD). Aparecem na Politica de Privacidade e nos Termos.
NEXT_PUBLIC_RESPONSAVEL_NOME=
NEXT_PUBLIC_CONTATO_EMAIL=
